\u1074\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1085\'3f\u1072\'3f\u1090\'3f 6 \u1086\'3f\u1090\'3f\u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1078\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1089\'3f\u1086\'3f\u1086\'3f\u1073\'3f\u1097\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f: \u1069\'3f\u1090\'3f\u1086\'3f \u1074\'3f\u1099\'3f\u1084\'3f\u1072\'3f\u1090\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1077\'3f\u1090\'3f. \u1042\'3f \u1090\'3f\u1077\'3f\u1088\'3f\u1072\'3f\u1087\'3f\u1080\'3f\u1080\'3f \u1085\'3f\u1072\'3f \u1085\'3f\u1091\'3f\u1078\'3f\u1085\'3f\u1086\'3f \u1090\'3f\u1072\'3f\u1097\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1074\'3f\u1089\'3f\u1105\'3f \u1074\'3f \u1086\'3f\u1076\'3f\u1080\'3f\u1085\'3f\u1086\'3f\u1095\'3f\u1082\'3f\u1091\'3f. \u1050\'3f\u1072\'3f\u1082\'3f \u1074\'3f\u1099\'3f \u1086\'3f\u1090\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1080\'3f\u1090\'3f\u1077\'3f\u1089\'3f\u1100\'3f \u1082\'3f \u1080\'3f\u1076\'3f\u1077\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1081\'3f\u1090\'3f\u1080\'3f \u1090\'3f\u1077\'3f\u1088\'3f\u1072\'3f\u1087\'3f\u1077\'3f\u1074\'3f\u1090\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1091\'3f\u1102\'3f \u1075\'3f\u1088\'3f\u1091\'3f\u1087\'3f\u1087\'3f\u1091\'3f? \u1050\'3f\u1085\'3f\u1086\'3f\u1087\'3f\u1082\'3f\u1080\'3f-\u1074\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1099\'3f: 9 \u1061\'3f\u1086\'3f\u1095\'3f\u1091\'3f \u1085\'3f\u1072\'3f\u1095\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1091\'3f\u1078\'3f\u1077\'3f \u1089\'3f\u1077\'3f\u1081\'3f\u1095\'3f\u1072\'3f\u1089\'3f 10 \u1044\'3f\u1091\'3f\u1084\'3f\u1072\'3f\u1102\'3f, \u1085\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1082\'3f\u1072\'3f \u1086\'3f\u1090\'3f\u1082\'3f\u1083\'3f\u1072\'3f\u1076\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1102\'3f 11 \u1048\'3f\u1085\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1089\'3f\u1085\'3f\u1086\'3f, \u1085\'3f\u1086\'3f \u1085\'3f\u1077\'3f\u1090\'3f \u1091\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f  \u1074\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1085\'3f\u1072\'3f\u1090\'3f 7 \u1086\'3f\u1090\'3f\u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1078\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1089\'3f\u1086\'3f\u1086\'3f\u1073\'3f\u1097\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f: \u1069\'3f\u1090\'3f\u1086\'3f \u1094\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1086\'3f, \u1085\'3f\u1086\'3f \u1086\'3f\u1085\'3f\u1080\'3f \u1085\'3f\u1077\'3f \u1074\'3f\u1089\'3f\u1077\'3f\u1075\'3f\u1076\'3f\u1072\'3f \u1084\'3f\u1086\'3f\u1075\'3f\u1091\'3f\u1090\'3f \u1076\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1080\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1086\'3f \u1090\'3f\u1086\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1084\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1090\'3f. \u1043\'3f\u1088\'3f\u1091\'3f\u1087\'3f\u1087\'3f\u1072\'3f - \u1073\'3f\u1077\'3f\u1079\'3f\u1086\'3f\u1087\'3f\u1072\'3f\u1089\'3f\u1085\'3f\u1086\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1086\'3f, \u1075\'3f\u1076\'3f\u1077\'3f \u1087\'3f\u1086\'3f\u1076\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1078\'3f\u1082\'3f\u1072\'3f \u1080\'3f\u1076\'3f\u1077\'3f\u1090\'3f \u1074\'3f\u1084\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1077\'3f \u1089\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1092\'3f\u1077\'3f\u1089\'3f\u1089\'3f\u1080\'3f\u1086\'3f\u1085\'3f\u1072\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1099\'3f\u1084\'3f\u1080\'3f \u1080\'3f\u1085\'3f\u1089\'3f\u1090\'3f\u1088\'3f\u1091\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1090\'3f\u1072\'3f\u1084\'3f\u1080\'3f. \u1050\'3f\u1072\'3f\u1082\'3f \u1074\'3f\u1099\'3f \u1086\'3f\u1090\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1080\'3f\u1090\'3f\u1077\'3f\u1089\'3f\u1100\'3f \u1082\'3f \u1080\'3f\u1076\'3f\u1077\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1081\'3f\u1090\'3f\u1080\'3f \u1090\'3f\u1077\'3f\u1088\'3f\u1072\'3f\u1087\'3f\u1077\'3f\u1074\'3f\u1090\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1091\'3f\u1102\'3f \u1075\'3f\u1088\'3f\u1091\'3f\u1087\'3f\u1087\'3f\u1091\'3f? \u1050\'3f\u1085\'3f\u1086\'3f\u1087\'3f\u1082\'3f\u1080\'3f-\u1074\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1099\'3f: 9 \u1061\'3f\u1086\'3f\u1095\'3f\u1091\'3f \u1085\'3f\u1072\'3f\u1095\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1091\'3f\u1078\'3f\u1077\'3f \u1089\'3f\u1077\'3f\u1081\'3f\u1095\'3f\u1072\'3f\u1089\'3f 10 \u1044\'3f\u1091\'3f\u1084\'3f\u1072\'3f\u1102\'3f, \u1085\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1082\'3f\u1072\'3f \u1086\'3f\u1090\'3f\u1082\'3f\u1083\'3f\u1072\'3f\u1076\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1102\'3f 11 \u1048\'3f\u1085\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1089\'3f\u1085\'3f\u1086\'3f, \u1085\'3f\u1086\'3f \u1085\'3f\u1077\'3f\u1090\'3f \u1091\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f  \u1074\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1085\'3f\u1072\'3f\u1090\'3f 8 \u1086\'3f\u1090\'3f\u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1078\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1089\'3f\u1086\'3f\u1086\'3f\u1073\'3f\u1097\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f: \u1069\'3f\u1090\'3f\u1086\'3f \u1074\'3f\u1099\'3f\u1084\'3f\u1072\'3f\u1090\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1077\'3f\u1090\'3f. \u1042\'3f \u1090\'3f\u1077\'3f\u1088\'3f\u1072\'3f\u1087\'3f\u1080\'3f\u1080\'3f \u1085\'3f\u1072\'3f \u1085\'3f\u1091\'3f\u1078\'3f\u1085\'3f\u1086\'3f \u1090\'3f\u1072\'3f\u1097\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1074\'3f\u1089\'3f\u1105\'3f \u1074\'3f \u1086\'3f\u1076\'3f\u1080\'3f\u1085\'3f\u1086\'3f\u1095\'3f\u1082\'3f\u1091\'3f. \u1050\'3f\u1072\'3f\u1082\'3f \u1074\'3f\u1099\'3f \u1086\'3f\u1090\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1080\'3f\u1090\'3f\u1077\'3f\u1089\'3f\u1100\'3f \u1082\'3f \u1080\'3f\u1076\'3f\u1077\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1081\'3f\u1090\'3f\u1080\'3f \u1090\'3f\u1077\'3f\u1088\'3f\u1072\'3f\u1087\'3f\u1077\'3f\u1074\'3f\u1090\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1091\'3f\u1102\'3f \u1075\'3f\u1088\'3f\u1091\'3f\u1087\'3f\u1087\'3f\u1091\'3f? \u1050\'3f\u1085\'3f\u1086\'3f\u1087\'3f\u1082\'3f\u1080\'3f-\u1074\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1099\'3f: 9 \u1061\'3f\u1086\'3f\u1095\'3f\u1091\'3f \u1085\'3f\u1072\'3f\u1095\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1091\'3f\u1078\'3f\u1077\'3f \u1089\'3f\u1077\'3f\u1081\'3f\u1095\'3f\u1072\'3f\u1089\'3f 10 \u1044\'3f\u1091\'3f\u1084\'3f\u1072\'3f\u1102\'3f, \u1085\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1082\'3f\u1072\'3f \u1086\'3f\u1090\'3f\u1082\'3f\u1083\'3f\u1072\'3f\u1076\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1102\'3f 11 \u1048\'3f\u1085\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1089\'3f\u1085\'3f\u1086\'3f, \u1085\'3f\u1086\'3f \u1085\'3f\u1077\'3f\u1090\'3f \u1091\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f
